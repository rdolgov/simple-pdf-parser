{
  "name": "pdf-layout-parser",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm install && npm --prefix testApp install && npm run build:lib && npm run build:server && npm --prefix testApp run build",
    "build:lib": "tsc -p tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "dev:server": "tsc -p server/tsconfig.json --watch",
    "start:server": "npm run build:server && node dist-server/index.js",
    "pages:build": "bash ./scripts/github-pages-build.sh",
    "pages:publish": "bash ./scripts/github-pages-publish.sh",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "pdf",
    "parser",
    "typescript",
    "layout"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.30.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.27",
    "pako": "^2.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.11.0",
    "@types/pako": "^2.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  }
}

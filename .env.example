# Copy this file to .env before running `docker compose up --build`.
# The Node server also auto-loads .env for non-Docker local runs.

HOST_BIND=127.0.0.1
HOST_PORT=8787
PUBLIC_ORIGIN=https://discoverlab.app
IMAGE_NAME=simple-pdf-parser:latest

# Optional upstream providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional proxy auth
LLM_PROXY_AUTH_TOKEN=
LLM_PROXY_USERS=
LLM_PROXY_SESSION_COOKIE_SECURE=true

# App routing
LLM_PROXY_ROOT_REDIRECT_PATH=/proxy
LLM_PROXY_CORS_ORIGIN=

# Optional model overrides
LLM_PROXY_GEMINI_MODEL=gemini-3-flash-preview
LLM_PROXY_GEMINI_BINARY_MODEL=

# Optional Codex passthrough
CODEX_EXEC_ENABLED=false
CODEX_EXEC_COMMAND=codex
